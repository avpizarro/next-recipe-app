# Keep actual values in .env.local (ignored by git) or Vercel environment settings.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google email addresses; empty means nobody can sign in.
ADMIN_EMAILS=
# Server-only Sanity token with document creation and image upload permissions.
SANITY_WRITE_TOKEN=
